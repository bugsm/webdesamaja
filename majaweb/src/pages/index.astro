---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import SectionHeading from "../components/SectionHeading.astro";
import HeroSection from "../components/react/HeroSection";
import StatsCounter from "../components/react/StatsCounter";
import NewsCard from "../components/react/NewsCard";
import ScrollReveal from "../components/react/ScrollReveal";

import { fetchSanity, urlForImage } from "../utils/sanity";
import { PortableText } from "@portabletext/react";

// Placeholder fallback
const fallbackNews = [
  {
    title: "Musyawarah Desa Bahas Pembangunan Jalan Dusun 3",
    excerpt:
      "Pemerintah Desa Maja mengadakan musyawarah desa untuk membahas rencana pembangunan jalan penghubung di Dusun 3 yang telah lama dinantikan warga.",
    date: "2026-07-15",
    category: "Pembangunan",
    slug: { current: "musyawarah-desa-pembangunan-jalan" },
    image: null,
  },
  {
    title: "Panen Raya Padi Organik Kelompok Tani Makmur",
    excerpt:
      "Kelompok Tani Makmur berhasil melaksanakan panen raya padi organik dengan hasil yang memuaskan berkat sistem irigasi baru.",
    date: "2026-07-10",
    category: "Kegiatan",
    slug: { current: "panen-raya-padi-organik" },
    image: null,
  },
  {
    title: "Pembagian BLT Dana Desa Tahap II Berjalan Lancar",
    excerpt:
      "Pemerintah Desa Maja sukses mendistribusikan Bantuan Langsung Tunai (BLT) Dana Desa Tahap II kepada 120 KPM.",
    date: "2026-07-05",
    category: "Pengumuman",
    slug: { current: "pembagian-blt-dana-desa-tahap-2" },
    image: null,
  },
];

// Fetch dari Sanity
const newsQuery = `*[_type == "berita"] | order(date desc)[0...3] {
  title, excerpt, date, category, slug, image
}`;
const allNews = await fetchSanity<any[]>(newsQuery);
const latestNews = allNews || fallbackNews;

// Ambil data statistik dari Sanity
const statsQuery = `*[_type == "statistik"][0]`;
const sanityStats = await fetchSanity<any>(statsQuery);

const profilQuery = `*[_type == "profil"][0]`;
const sanityProfil = await fetchSanity<any>(profilQuery);

const potensiQuery = `*[_type == "potensi"][0...3]`;
const allPotensi = await fetchSanity<any[]>(potensiQuery);
const potensiDesa = allPotensi && allPotensi.length > 0 ? allPotensi : [
  {
    title: "Pertanian & Perkebunan",
    description:
      "Hasil bumi unggulan berupa padi, jagung, singkong, dan kelapa sawit yang menjadi sumber ekonomi utama warga desa.",
    icon: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" /></svg>`,
  },
  {
    title: "Wisata Alam",
    description:
      "Potensi pariwisata berupa air terjun, perbukitan hijau, dan keindahan alam pesisir Lampung Selatan yang masih asri.",
    icon: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" /></svg>`,
  },
  {
    title: "UMKM & Kerajinan",
    description:
      "Produk olahan rumahan, kerajinan tangan, dan makanan khas Lampung yang diproduksi warga desa untuk pasar lokal dan regional.",
    icon: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 01.75-.75h3a.75.75 0 01.75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349m-16.5 11.65V9.35m0 0a3.001 3.001 0 003.75-.615A2.993 2.993 0 009.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 002.25 1.016c.896 0 1.7-.393 2.25-1.016A3.001 3.001 0 0021 9.349m-18 0a2.998 2.998 0 013.25-1.116c.334-.04.675-.062 1.024-.062a2.998 2.998 0 012.476 1.312m-6.75-.134c-.064.027-.127.056-.19.086M3 9.349c.064.027.127.056.19.086" /></svg>`,
  },
];
---

<BaseLayout title="Beranda" description="Website resmi Desa Maja, Kecamatan Kalianda, Kabupaten Lampung Selatan. Portal informasi profil desa, peta wilayah, berita, dan potensi desa.">
  <Navbar slot="header" />

  <!-- Hero Section -->
  <HeroSection client:load />

  <!-- Stats Counter -->
  <StatsCounter client:visible sanityStats={sanityStats} />

  <!-- Sambutan Kepala Desa -->
  <section class="section-padding bg-transparent">
    <div class="container-village">
      <ScrollReveal client:visible>
        <div class="grid md:grid-cols-2 gap-10 lg:gap-16 items-center">
          <div>
            <SectionHeading title="Sambutan Kepala Desa" centered={false} />
            <div class="space-y-4 text-[var(--color-foreground)]/80 leading-relaxed">
              <PortableText value={sanityProfil?.sambutanKepalaDesa || [
                { _type: 'block', style: 'normal', children: [{ _type: 'span', text: "Assalamu'alaikum Warahmatullahi Wabarakatuh," }]},
                { _type: 'block', style: 'normal', children: [{ _type: 'span', text: "Puji syukur kita panjatkan ke hadirat Allah SWT atas segala rahmat dan karunia-Nya. Atas nama Pemerintah Desa Maja, saya menyampaikan selamat datang di website resmi Desa Maja." }]},
                { _type: 'block', style: 'normal', children: [{ _type: 'span', text: "Website ini kami hadirkan sebagai wujud komitmen kami dalam mewujudkan transparansi dan keterbukaan informasi publik." }]}
              ]} />
              <div class="mt-6 pt-4 border-t border-[var(--color-border)]">
                <p class="font-bold text-[var(--color-primary-dark)]" style="font-family: var(--font-heading);">
                  {sanityProfil?.namaKepalaDesa || "Kepala Desa"}
                </p>
                <p class="text-sm text-[var(--color-muted-foreground)]">Kepala Desa Maja</p>
              </div>
            </div>
          </div>
          <div class="relative">
            {sanityProfil?.fotoKantor ? (
              <div class="aspect-[4/3] rounded-xl bg-[var(--color-muted)] overflow-hidden shadow-lg">
                <img src={urlForImage(sanityProfil.fotoKantor).url()} alt="Foto Kantor Desa" class="w-full h-full object-cover" />
              </div>
            ) : (
              <div class="aspect-[4/3] rounded-xl bg-[var(--color-muted)] overflow-hidden shadow-lg">
                <div class="w-full h-full flex items-center justify-center text-[var(--color-muted-foreground)]">
                  <div class="text-center">
                    <svg class="w-16 h-16 mx-auto mb-3 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" />
                    </svg>
                    <p class="text-sm">Foto Kantor / Suasana Desa</p>
                    <p class="text-xs opacity-60">Upload via admin CMS</p>
                  </div>
                </div>
              </div>
            )}
            {/* Decorative accent */}
            <div class="absolute -bottom-3 -right-3 w-24 h-24 rounded-xl bg-[var(--color-accent)]/20 -z-10"></div>
          </div>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <!-- Potensi Desa Highlights -->
  <section class="section-padding bg-transparent">
    <div class="container-village">
      <SectionHeading
        title="Potensi Desa Maja"
        subtitle="Beragam potensi yang dimiliki desa kami untuk kesejahteraan masyarakat"
      />

      <div class="grid md:grid-cols-3 gap-6 md:gap-8">
        {potensiDesa.map((item, index) => (
          <ScrollReveal client:visible delay={index * 0.1}>
            <div class="group bg-white rounded-xl p-6 md:p-8 shadow-sm hover:shadow-lg transition-all duration-300 border border-transparent hover:border-[var(--color-border)] h-full">
              <div class="w-14 h-14 rounded-lg bg-[var(--color-primary)]/10 text-[var(--color-primary)] flex items-center justify-center mb-5 group-hover:bg-[var(--color-primary)] group-hover:text-white transition-colors duration-300">
                <Fragment set:html={item.icon} />
              </div>
              <h3 class="text-lg font-bold text-[var(--color-primary-dark)] mb-2" style="font-family: var(--font-heading);">
                {item.title}
              </h3>
              <p class="text-sm text-[var(--color-muted-foreground)] leading-relaxed">
                {item.description}
              </p>
            </div>
          </ScrollReveal>
        ))}
      </div>

      <div class="mt-10 text-center">
        <a
          href="/potensi"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-[var(--color-primary)] text-white font-semibold hover:bg-[var(--color-primary-light)] transition-all duration-200 cursor-pointer shadow-md hover:shadow-lg"
        >
          Lihat Semua Potensi
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Berita Terbaru -->
  <section class="section-padding bg-transparent">
    <div class="container-village">
      <SectionHeading
        title="Berita Terbaru"
        subtitle="Informasi dan kegiatan terkini dari Desa Maja"
      />

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {latestNews.map((news) => (
          <NewsCard
            client:visible
            title={news.title}
            excerpt={news.excerpt}
            date={news.date}
            category={news.category}
            slug={news.slug?.current || news.slug}
          />
        ))}
      </div>

      <div class="mt-10 text-center">
        <a
          href="/berita"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border-2 border-[var(--color-primary)] text-[var(--color-primary)] font-semibold hover:bg-[var(--color-primary)] hover:text-white transition-all duration-200 cursor-pointer"
        >
          Lihat Semua Berita
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-16 md:py-20 bg-[var(--color-primary-dark)] relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_25%_25%,_rgba(255,255,255,0.15)_1px,_transparent_1px),_radial-gradient(circle_at_75%_75%,_rgba(255,255,255,0.1)_1px,_transparent_1px)] bg-[length:40px_40px]"></div>
    <div class="container-village relative z-10 text-center">
      <ScrollReveal client:visible>
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-4" style="font-family: var(--font-heading);">
          Jelajahi Peta Desa Maja
        </h2>
        <p class="text-white/70 text-base md:text-lg max-w-xl mx-auto mb-8">
          Lihat batas wilayah, fasilitas umum, dan potensi desa dalam peta interaktif.
        </p>
        <a
          href="/peta"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-lg bg-[var(--color-accent)] text-[var(--color-primary-dark)] font-bold text-lg hover:bg-[var(--color-accent-dark)] hover:text-white transition-all duration-200 cursor-pointer shadow-lg hover:shadow-xl"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
          Buka Peta Interaktif
        </a>
      </ScrollReveal>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
