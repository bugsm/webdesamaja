---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ContactMap from "../components/react/ContactMap";
import ScrollReveal from "../components/react/ScrollReveal";

const contactDetails = [
  {
    label: "Alamat",
    value: "Desa Maja, Kecamatan Kalianda, Kabupaten Lampung Selatan, Provinsi Lampung 35513",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`,
  },
  {
    label: "Telepon",
    value: "(0727) 000-0000",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>`,
  },
  {
    label: "Email",
    value: "desa.maja@lampungselatankab.go.id",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>`,
  },
  {
    label: "Jam Pelayanan",
    value: "Senin – Jumat: 08.00 – 15.00 WIB",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  },
];
---

<BaseLayout title="Kontak" description="Hubungi Pemerintah Desa Maja. Alamat kantor desa, nomor telepon, email, dan formulir kontak online.">
  <Navbar slot="header" />

  <!-- Page Hero -->
  <section class="bg-[var(--color-primary-dark)] py-16 md:py-20">
    <div class="container-village text-center">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4" style="font-family: var(--font-heading);">
        Hubungi Kami
      </h1>
      <p class="text-white/70 text-base md:text-lg max-w-2xl mx-auto">
        Silakan hubungi kami untuk informasi lebih lanjut atau sampaikan aspirasi 
        Anda kepada Pemerintah Desa Maja.
      </p>
      <div class="mt-4 h-1 w-16 rounded-full bg-[var(--color-accent)] mx-auto"></div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section-padding bg-[var(--color-background)]">
    <div class="container-village">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16">
        <!-- Contact Info + Map -->
        <div>
          <ScrollReveal client:visible direction="left">
            <h2 class="text-2xl font-bold text-[var(--color-primary-dark)] mb-6" style="font-family: var(--font-heading);">
              Informasi Kontak
            </h2>

            <div class="space-y-5 mb-8">
              {contactDetails.map((item) => (
                <div class="flex items-start gap-4">
                  <div class="w-11 h-11 shrink-0 rounded-xl bg-[var(--color-primary)]/10 text-[var(--color-primary)] flex items-center justify-center">
                    <Fragment set:html={item.icon} />
                  </div>
                  <div>
                    <p class="text-sm font-semibold text-[var(--color-primary-dark)]" style="font-family: var(--font-heading);">
                      {item.label}
                    </p>
                    <p class="text-sm text-[var(--color-muted-foreground)] mt-0.5">
                      {item.value}
                    </p>
                  </div>
                </div>
              ))}
            </div>

            {/* Mini Map */}
            <h3 class="text-lg font-bold text-[var(--color-primary-dark)] mb-3" style="font-family: var(--font-heading);">
              Lokasi Kantor Desa
            </h3>
            <ContactMap client:only="react" />
          </ScrollReveal>
        </div>

        <!-- Contact Form -->
        <div>
          <ScrollReveal client:visible direction="right">
            <h2 class="text-2xl font-bold text-[var(--color-primary-dark)] mb-6" style="font-family: var(--font-heading);">
              Kirim Pesan
            </h2>

            <form class="bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-[var(--color-border)]" id="contact-form">
              <div class="space-y-5">
                {/* Nama */}
                <div>
                  <label for="contact-name" class="block text-sm font-semibold text-[var(--color-foreground)] mb-1.5">
                    Nama Lengkap <span class="text-[var(--color-destructive)]">*</span>
                  </label>
                  <input
                    type="text"
                    id="contact-name"
                    name="name"
                    required
                    placeholder="Masukkan nama lengkap"
                    class="w-full px-4 py-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-background)] text-[var(--color-foreground)] text-sm transition-all duration-200 focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:outline-none placeholder:text-[var(--color-muted-foreground)]/50"
                  />
                </div>

                {/* Email */}
                <div>
                  <label for="contact-email" class="block text-sm font-semibold text-[var(--color-foreground)] mb-1.5">
                    Email <span class="text-[var(--color-destructive)]">*</span>
                  </label>
                  <input
                    type="email"
                    id="contact-email"
                    name="email"
                    required
                    placeholder="contoh@email.com"
                    class="w-full px-4 py-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-background)] text-[var(--color-foreground)] text-sm transition-all duration-200 focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:outline-none placeholder:text-[var(--color-muted-foreground)]/50"
                  />
                </div>

                {/* Subjek */}
                <div>
                  <label for="contact-subject" class="block text-sm font-semibold text-[var(--color-foreground)] mb-1.5">
                    Subjek
                  </label>
                  <select
                    id="contact-subject"
                    name="subject"
                    class="w-full px-4 py-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-background)] text-[var(--color-foreground)] text-sm transition-all duration-200 focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:outline-none cursor-pointer"
                  >
                    <option value="">Pilih subjek...</option>
                    <option value="informasi">Permintaan Informasi</option>
                    <option value="layanan">Pelayanan Administrasi</option>
                    <option value="aspirasi">Aspirasi / Saran</option>
                    <option value="pengaduan">Pengaduan</option>
                    <option value="lainnya">Lainnya</option>
                  </select>
                </div>

                {/* Pesan */}
                <div>
                  <label for="contact-message" class="block text-sm font-semibold text-[var(--color-foreground)] mb-1.5">
                    Pesan <span class="text-[var(--color-destructive)]">*</span>
                  </label>
                  <textarea
                    id="contact-message"
                    name="message"
                    required
                    rows="5"
                    placeholder="Tulis pesan Anda di sini..."
                    class="w-full px-4 py-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-background)] text-[var(--color-foreground)] text-sm transition-all duration-200 focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:outline-none placeholder:text-[var(--color-muted-foreground)]/50 resize-y"
                  ></textarea>
                </div>

                {/* Submit */}
                <button
                  type="submit"
                  class="w-full px-6 py-3.5 rounded-xl bg-[var(--color-primary)] text-white font-semibold text-base hover:bg-[var(--color-primary-light)] transition-all duration-200 cursor-pointer shadow-md hover:shadow-lg flex items-center justify-center gap-2"
                >
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                  </svg>
                  Kirim Pesan
                </button>
              </div>
            </form>

            <p class="mt-4 text-xs text-[var(--color-muted-foreground)] text-center">
              Form ini belum terhubung ke backend. Integrasi email akan diaktifkan pada fase deployment.
            </p>
          </ScrollReveal>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
