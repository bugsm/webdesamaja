---
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import BeritaListing from "../../components/BeritaListing.astro";

import { fetchSanity, urlForImage } from "../../utils/sanity";

// Dirender saat diakses, bukan saat build — supaya berita baru dari Sanity
// langsung tampil tanpa deploy ulang.
export const prerender = false;

const PAGE_SIZE = 10;

// Placeholder bila Sanity kosong
const fallbackNews = [
  {
    title: "Musyawarah Desa Bahas Pembangunan Jalan Dusun 3",
    excerpt: "Pemerintah Desa Maja mengadakan musyawarah desa untuk membahas rencana pembangunan jalan penghubung di Dusun 3.",
    date: "2026-07-15",
    category: "Pembangunan",
    slug: { current: "musyawarah-desa-pembangunan-jalan" },
    image: null,
  },
];

// Ambil semua berita (urut terbaru), lalu ambil 10 pertama untuk halaman 1
const query = `*[_type == "berita"] | order(date desc) {
  title, excerpt, date, category, slug, image
}`;
const sanityNews = await fetchSanity<any[]>(query);
const allNews = sanityNews && sanityNews.length > 0 ? sanityNews : fallbackNews;

const totalPages = Math.max(1, Math.ceil(allNews.length / PAGE_SIZE));
const posts = allNews.slice(0, PAGE_SIZE).map((n) => ({
  title: n.title,
  excerpt: n.excerpt,
  date: n.date,
  category: n.category,
  slug: n.slug?.current || n.slug,
  image: n.image ? urlForImage(n.image).width(800).height(600).url() : undefined,
}));
---

<BaseLayout title="Berita" description="Berita dan informasi terkini dari Desa Maja. Pengumuman, kegiatan, pembangunan, dan informasi penting lainnya untuk warga desa.">
  <Navbar slot="header" />

  <!-- Page Hero -->
  <section class="gradient-primary py-16 md:py-20">
    <div class="container-village text-center">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4" style="font-family: var(--font-heading);">
        Berita Desa
      </h1>
      <p class="text-white/70 text-base md:text-lg max-w-2xl mx-auto">
        Informasi terkini seputar kegiatan, pembangunan, dan pengumuman penting
        dari Pemerintah Desa Maja.
      </p>
      <div class="mt-4 h-1 w-16 rounded-full bg-[var(--color-accent)] mx-auto"></div>
    </div>
  </section>

  <!-- News Grid + Pagination -->
  <section class="section-padding bg-transparent">
    <div class="container-village">
      <BeritaListing posts={posts} currentPage={1} totalPages={totalPages} />
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
