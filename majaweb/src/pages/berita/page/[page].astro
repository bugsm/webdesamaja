---
import "../../../styles/global.css";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import BeritaListing from "../../../components/BeritaListing.astro";
import { fetchSanity, urlForImage } from "../../../utils/sanity";

// Dirender saat diakses — jumlah halaman ikut bertambah otomatis saat berita baru
// dipublish, tanpa deploy ulang. Karena itu getStaticPaths() tidak dipakai lagi:
// nomor halaman dibaca langsung dari URL.
export const prerender = false;

const PAGE_SIZE = 10;

// Halaman 1 ada di /berita, jadi rute ini hanya melayani halaman 2 ke atas.
const currentPage = Number(Astro.params.page);
if (!Number.isInteger(currentPage) || currentPage < 2) {
  return Astro.redirect("/berita");
}

const query = `*[_type == "berita"] | order(date desc) {
  title, excerpt, date, category, slug, image
}`;
const allNews = (await fetchSanity<any[]>(query)) || [];
const totalPages = Math.max(1, Math.ceil(allNews.length / PAGE_SIZE));

// Nomor halaman melebihi jumlah berita yang ada
if (currentPage > totalPages) {
  return Astro.redirect("/berita");
}

const posts = allNews.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);
const resolved = posts.map((n: any) => ({
  title: n.title,
  excerpt: n.excerpt,
  date: n.date,
  category: n.category,
  slug: n.slug?.current || n.slug,
  image: n.image ? urlForImage(n.image).width(800).height(600).url() : undefined,
}));
---

<BaseLayout title={`Berita — Halaman ${currentPage}`} description={`Kumpulan berita Desa Maja, halaman ${currentPage}.`}>
  <Navbar slot="header" />

  <!-- Page Hero -->
  <section class="gradient-primary py-16 md:py-20">
    <div class="container-village text-center">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4" style="font-family: var(--font-heading);">
        Berita Desa
      </h1>
      <p class="text-white/70 text-base md:text-lg max-w-2xl mx-auto">
        Informasi terkini seputar kegiatan, pembangunan, dan pengumuman penting
        dari Pemerintah Desa Maja.
      </p>
      <div class="mt-4 h-1 w-16 rounded-full bg-[var(--color-accent)] mx-auto"></div>
    </div>
  </section>

  <!-- News Grid + Pagination -->
  <section class="section-padding bg-transparent">
    <div class="container-village">
      <BeritaListing posts={resolved} currentPage={currentPage} totalPages={totalPages} />
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
