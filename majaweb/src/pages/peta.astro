---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import VillageMap from "../components/react/VillageMap";
import { fetchSanity } from "../utils/sanity";

const query = `*[_type == "fasilitas"] {
  name, type, "lat": coordinates.lat, "lng": coordinates.lng, description
}`;
const sanityFasilitas = await fetchSanity<any[]>(query);
---

<BaseLayout title="Peta Desa" description="Peta interaktif Desa Maja. Lihat batas wilayah, lokasi fasilitas umum, sekolah, tempat ibadah, kesehatan, dan potensi wisata desa.">
  <Navbar slot="header" />

  <!-- Page Hero -->
  <section class="bg-[var(--color-primary-dark)] py-12 md:py-16">
    <div class="container-village text-center">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4" style="font-family: var(--font-heading);">
        Peta Desa Maja
      </h1>
      <p class="text-white/70 text-base md:text-lg max-w-2xl mx-auto">
        Peta interaktif wilayah Desa Maja. Klik marker untuk melihat informasi fasilitas, 
        dan gunakan panel layer di kanan atas untuk menampilkan/menyembunyikan kategori.
      </p>
      <div class="mt-4 h-1 w-16 rounded-full bg-[var(--color-accent)] mx-auto"></div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="section-padding bg-[var(--color-background)]">
    <div class="container-village">
      {/* Legend */}
      <div class="mb-6 flex flex-wrap gap-4 justify-center text-sm">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[#DC2626]"></span>
          <span class="text-[var(--color-foreground)]">Kantor Desa</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[#2563EB]"></span>
          <span class="text-[var(--color-foreground)]">Sekolah</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[#16A34A]"></span>
          <span class="text-[var(--color-foreground)]">Kesehatan</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[#7C3AED]"></span>
          <span class="text-[var(--color-foreground)]">Tempat Ibadah</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[#D97706]"></span>
          <span class="text-[var(--color-foreground)]">Pasar / Ekonomi</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[#0891B2]"></span>
          <span class="text-[var(--color-foreground)]">Wisata</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-5 h-0.5 border-t-2 border-dashed border-[var(--color-primary)]"></span>
          <span class="text-[var(--color-foreground)]">Batas Wilayah (perkiraan)</span>
        </div>
      </div>

      {/* Map */}
      <div class="h-[600px] rounded-3xl overflow-hidden shadow-lg border-4 border-white">
        <VillageMap client:only="react" facilities={sanityFasilitas || undefined} />
      </div>

      {/* Disclaimer */}
      <div class="mt-6 p-4 rounded-xl bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/30">
        <div class="flex gap-3 items-start">
          <svg class="w-5 h-5 text-[var(--color-accent-dark)] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
          </svg>
          <div>
            <p class="font-semibold text-[var(--color-accent-dark)] text-sm" style="font-family: var(--font-heading);">
              Catatan Penting
            </p>
            <p class="text-sm text-[var(--color-foreground)]/70 mt-1">
              Batas wilayah yang ditampilkan bersifat <strong>perkiraan (dummy data)</strong>. 
              File shapefile resmi batas desa sedang dalam proses pembuatan. Setelah data resmi tersedia, 
              batas wilayah akan diperbarui secara otomatis. Koordinat titik fasilitas juga bersifat 
              perkiraan dan akan dikonfirmasi oleh admin desa melalui CMS.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
