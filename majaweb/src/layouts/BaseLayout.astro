---
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "Website resmi Desa Maja, Kecamatan Kalianda, Kabupaten Lampung Selatan, Provinsi Lampung. Informasi profil desa, peta wilayah, berita, dan potensi desa.",
  ogImage = "/images/og-default.jpg",
} = Astro.props;

const siteTitle = `${title} — Desa Maja`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "https://desamaja.id");
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Pemerintah Desa Maja" />

    <!-- Open Graph -->
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:url" content={canonicalURL.href} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/logoku.svg" />
    <link rel="icon" type="image/x-icon" href="/logoku.svg" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{siteTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-grid text-[var(--color-foreground)] overflow-x-hidden">
    <slot name="header" />
    <main class="flex-1">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
